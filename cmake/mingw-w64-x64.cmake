set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

if(DEFINED ENV{MINGW_ROOT} AND NOT "$ENV{MINGW_ROOT}" STREQUAL "")
    set(CMAKE_C_COMPILER "$ENV{MINGW_ROOT}/x86_64-w64-mingw32-gcc")
    set(CMAKE_CXX_COMPILER "$ENV{MINGW_ROOT}/x86_64-w64-mingw32-g++")
    set(CMAKE_RC_COMPILER "$ENV{MINGW_ROOT}/x86_64-w64-mingw32-windres")
else()
    set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
    set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
    set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
